# Backend configuration — copy to `.env` and fill in. Do NOT commit `.env`.

# --- IBKR connection (read by backend/main.py) ---
IBKR_HOST=127.0.0.1
IBKR_PORT=4002          # 4002=IB Gateway, 7497=TWS paper, 7496=TWS live
IBKR_CLIENT_ID=1

# --- Logging (read by backend/ibkr_client.py) ---
LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR

# --- Fundamentals cache (read by backend/stock_analysis_scraper.py) ---
FUNDAMENTALS_CACHE_HOURS=24   # in-process cache TTL for StockAnalysis responses

# --- StockAnalysis.com ---
# The scraper uses StockAnalysis.com's public JSON API and works WITHOUT auth
# for free-tier fundamentals — leave everything below blank for normal use.
#
# STOCKANALYSIS_SESSION_COOKIE is optional: when set, its value is forwarded as
# the `Cookie` header on each request to unlock Pro-only data. EMAIL/PASSWORD are
# placeholders for future interactive login and are currently unused by the API.
# Paste a real cookie value here only in your local .env — never commit it.
STOCKANALYSIS_EMAIL=
STOCKANALYSIS_PASSWORD=
STOCKANALYSIS_SESSION_COOKIE=
