# IBKR connection
IBKR_HOST=127.0.0.1
IBKR_PORT=4002          # 4002=IB Gateway, 7497=TWS paper, 7496=TWS live
IBKR_CLIENT_ID=1
IBKR_ACCOUNT_ID=        # optional, leave blank for default

# StockAnalysis.com Pro
STOCKANALYSIS_EMAIL=
STOCKANALYSIS_PASSWORD=
STOCKANALYSIS_SESSION_COOKIE=    # optional, if scraping via cookie

# App
API_PORT=8000
LOG_LEVEL=INFO

# Cache
FUNDAMENTALS_CACHE_HOURS=24
PRICE_HISTORY_CACHE_HOURS=1
